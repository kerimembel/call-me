{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC hub: control Claude Code + Codex agents from Telegram, let them talk over an MCP bus, planner/worker model tiers",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "mock": "HUB_MOCK=1 tsx src/index.ts",
    "demo": "HUB_MOCK=1 HUB_NO_TELEGRAM=1 tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.4",
    "grammy": "^1.46.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
