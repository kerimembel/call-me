# Telegram bot (create with @BotFather). Long polling: no public URL needed.
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids allowed to command the hub (leave empty = anyone, not recommended)
TELEGRAM_ALLOWED_USER_IDS=
# Optional: chat id for proactive notifications before the first /start
TELEGRAM_CHAT_ID=

# Default repository the agents work in (or /repo from Telegram)
HUB_REPO=/path/to/your/repo
# claude | codex : who plans/reviews (top-tier model), other vendor(s) implement
HUB_PLANNER_VENDOR=claude
# telegram | auto : where Claude Code permission prompts go
HUB_APPROVALS=telegram

# Vendor auth is whatever the CLIs already use: `claude` login (or ANTHROPIC_API_KEY) and `codex login` (or OPENAI_API_KEY).
