{
  "name": "callme-extension",
  "displayName": "CallMe for Antigravity",
  "description": "Integration for CallMe service (Phone & Telegram) for AI Agents",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "callme.callUser",
        "title": "CallMe: Call User",
        "category": "CallMe"
      },
      {
        "command": "callme.telegramAsk",
        "title": "CallMe: Ask via Telegram",
        "category": "CallMe"
      }
    ],
    "configuration": {
      "title": "CallMe",
      "properties": {
        "callme.serverUrl": {
          "type": "string",
          "default": "http://localhost:3333",
          "description": "URL of the CallMe server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
